      "story": {
        "title": "The Missing Ward",
        "genre": "Civic mystery",
        "tone": "Patient and intimate",
        "premise": "Surveyor Iven finds a salt-stained ledger whose record of an inhabited ward was scraped away.",
        "conflict": "Correct the public census or trust anonymous witnesses who fear official enumeration.",
        "motivation": "Iven's childhood ward will lose its flood rations.",
        "opposition": "The Salt Hall clerks demand a public list of names.",
        "background": "Ward assemblies ration salt and dry shelter by the last census.",
        "progression": [
          "Recover the ledger at Reedmill.",
          "Compare flood marks at the gate.",
          "Choose the terms of recognition."
        ],
        "possibleEndings": [
          "Restore the roll at Salt Hall.",
          "Keep a witness register at the beacon."
        ]
      },
