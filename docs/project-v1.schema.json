{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "WORLDWEAVER portable project v1",
  "$ref": "#/definitions/Project",
  "definitions": {
    "Id": {"type":"string", "pattern":"^[a-z][a-z0-9-]{0,95}$"},
    "Point": {"type":"array", "minItems":2, "maxItems":2, "items":{"type":"integer", "minimum":0}},
    "Story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title","genre","tone","premise","conflict","motivation","opposition","background","progression","possibleEndings"],
      "properties": {
        "title": {"type":"string", "minLength":1},
        "genre": {"type":"string", "minLength":1},
        "tone": {"type":"string", "minLength":1},
        "premise": {"type":"string", "minLength":1},
        "conflict": {"type":"string", "minLength":1},
        "motivation": {"type":"string", "minLength":1},
        "opposition": {"type":"string", "minLength":1},
        "background": {"type":"string", "minLength":1},
        "progression": {"type":"array", "items":{"type":"string", "minLength":1}, "minItems":1},
        "possibleEndings": {"type":"array", "items":{"type":"string", "minLength":1}, "minItems":1}
      }
    },
    "Coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentId", "disposition", "reason"],
      "properties": {
        "contentId": {"$ref":"#/definitions/Id"},
        "disposition": {"enum":["incorporated", "unused", "conflict", "excluded"]},
        "reason": {"type":"string", "minLength":1}
      }
    },
    "UserContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "treatment", "text"],
      "properties": {
        "id": {"$ref":"#/definitions/Id"},
        "category": {
          "enum": ["genre","theme","character","faction","creature","item","location","history","mechanic","ending","constraint","idea"]
        },
        "treatment": {"enum":["mandatory", "optional", "excluded"]},
        "text": {"type":"string", "minLength":1}
      }
    },
    "CanonicalFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement"],
      "properties": {
        "id": {"$ref":"#/definitions/Id"},
        "statement": {"type":"string", "minLength":1},
        "sourceContentId": {"$ref":"#/definitions/Id"}
      }
    },
    "StoryCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "story", "coverage"],
      "properties": {
        "id": {"$ref":"#/definitions/Id"},
        "story": {"$ref":"#/definitions/Story"},
        "coverage": {"type":"array", "items":{"$ref":"#/definitions/Coverage"}}
      }
    },
    "Narrative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceCandidateId", "story", "approved"],
      "properties": {
        "id": {"$ref":"#/definitions/Id"},
        "sourceCandidateId": {"$ref":"#/definitions/Id"},
        "story": {"$ref":"#/definitions/Story"},
        "approved": {"type":"boolean"}
      }
    },
    "StateEntity": {
      "type":"object", "additionalProperties":false, "required":["id","kind","name"],
      "properties": {
        "id":{"$ref":"#/definitions/Id"},
        "kind":{"enum":["item","decision","flag"]},
        "name":{"type":"string","minLength":1}
      }
    },
    "Character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "role"],
      "properties": {
        "id": {"$ref":"#/definitions/Id"},
        "name": {"type":"string", "minLength":1},
        "role": {"type":"string", "minLength":1},
        "factionId": {"$ref":"#/definitions/Id"}
      }
    },
    "Faction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "aim"],
      "properties": {
        "id": {"$ref":"#/definitions/Id"},
        "name": {"type":"string", "minLength":1},
        "aim": {"type":"string", "minLength":1}
      }
    },
    "StateTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "key", "value"],
      "properties": {
        "kind": {"enum":["quest","item","decision","relationship","flag","character","location"]},
        "key": {"$ref":"#/definitions/Id"},
        "value": {"type":"string","minLength":1}
      }
    },
    "ScenarioSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale", "chapterCount", "branching", "mainQuests", "sideQuests", "endings", "instructions"],
      "properties": {
        "scale": {"enum":["short","standard"]},
        "chapterCount": {"type":"integer","minimum":1,"maximum":4},
        "branching": {"enum":["linear","branching"]},
        "mainQuests": {"enum":["light","strong"]},
        "sideQuests": {"enum":["none","some"]},
        "endings": {"enum":["single","multiple"]},
        "instructions": {"type":"string","maxLength":1200}
      }
    },
    "Chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "purpose", "summary"],
      "properties": {
        "id": {"$ref":"#/definitions/Id"},
        "title": {"type":"string","minLength":1},
        "purpose": {"type":"string","minLength":1},
        "summary": {"type":"string","minLength":1}
      }
    },
    "Scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "sourceNarrativeId", "approved", "settings", "chapters", "locations", "geography", "factIds", "contentIds", "layout"],
      "properties": {
        "id": {"$ref":"#/definitions/Id"},
        "title": {"type":"string","minLength":1},
        "summary": {"type":"string","minLength":1},
        "sourceNarrativeId": {"$ref":"#/definitions/Id"},
        "approved": {"type":"boolean"},
        "settings": {"$ref":"#/definitions/ScenarioSettings"},
        "chapters": {"type":"array","items":{"$ref":"#/definitions/Chapter"}},
        "locations": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","name","kind","purpose"],"properties":{"id":{"$ref":"#/definitions/Id"},"name":{"type":"string","minLength":1},"kind":{"enum":["city","village","dungeon","landmark","port"]},"purpose":{"type":"string","minLength":1}}}},
        "geography": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["from","to","relation","description"],"properties":{"from":{"$ref":"#/definitions/Id"},"to":{"$ref":"#/definitions/Id"},"via":{"$ref":"#/definitions/Id"},"relation":{"enum":["near","beneath","separates","travel"]},"description":{"type":"string","minLength":1}}}},
        "factIds": {"type":"array","items":{"$ref":"#/definitions/Id"},"uniqueItems":true},
        "contentIds": {"type":"array","items":{"$ref":"#/definitions/Id"},"uniqueItems":true},
        "layout": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["nodeId","x","y"],"properties":{"nodeId":{"$ref":"#/definitions/Id"},"x":{"type":"number"},"y":{"type":"number"}}}}
      }
    },
    "ScenarioNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "description", "mandatory", "characterIds", "requiresVisited"],
      "properties": {
        "chapterId": {"$ref":"#/definitions/Id"},
        "purpose": {"type":"string","minLength":1},
        "outcome": {"type":"string","minLength":1},
        "factionIds": {"type":"array","items":{"$ref":"#/definitions/Id"},"uniqueItems":true},
        "conditions": {"type":"array","items":{"$ref":"#/definitions/StateTerm"}},
        "consequences": {"type":"array","items":{"$ref":"#/definitions/StateTerm"}},
        "id": {"$ref":"#/definitions/Id"},
        "kind": {"enum":["prologue", "chapter", "event", "quest", "choice", "ending", "dialogue", "encounter", "condition", "transition"]},
        "title": {"type":"string", "minLength":1},
        "description": {"type":"string", "minLength":1},
        "mandatory": {"type":"boolean"},
        "objective": {"type":"string", "minLength":1},
        "characterIds": {"type":"array", "items":{"$ref":"#/definitions/Id"}, "uniqueItems":true},
        "locationId": {"$ref":"#/definitions/Id"},
        "requiresVisited": {"type":"array", "items":{"$ref":"#/definitions/Id"}, "uniqueItems":true}
      }
    },
    "ScenarioEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "label", "requiresVisited", "travel"],
      "properties": {
        "kind": {"enum":["progression","optional","reference"]},
        "conditions": {"type":"array","items":{"$ref":"#/definitions/StateTerm"}},
        "consequences": {"type":"array","items":{"$ref":"#/definitions/StateTerm"}},
        "id": {"$ref":"#/definitions/Id"},
        "from": {"$ref":"#/definitions/Id"},
        "to": {"$ref":"#/definitions/Id"},
        "label": {"type":"string", "minLength":1},
        "requiresVisited": {"type":"array", "items":{"$ref":"#/definitions/Id"}, "uniqueItems":true},
        "travel": {"enum":["required", "none"]}
      }
    },
    "Quest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nodeId", "objective", "outcome"],
      "properties": {
        "kind": {"enum":["main","side"]},
        "title": {"type":"string","minLength":1},
        "description": {"type":"string","minLength":1},
        "prerequisiteIds": {"type":"array","items":{"$ref":"#/definitions/Id"},"uniqueItems":true},
        "completion": {"type":"array","items":{"$ref":"#/definitions/StateTerm"}},
        "failure": {"type":"array","items":{"$ref":"#/definitions/StateTerm"}},
        "reward": {"type":"string","minLength":1},
        "characterIds": {"type":"array","items":{"$ref":"#/definitions/Id"},"uniqueItems":true},
        "factionIds": {"type":"array","items":{"$ref":"#/definitions/Id"},"uniqueItems":true},
        "locationIds": {"type":"array","items":{"$ref":"#/definitions/Id"},"uniqueItems":true},
        "id": {"$ref":"#/definitions/Id"},
        "nodeId": {"$ref":"#/definitions/Id"},
        "objective": {"type":"string", "minLength":1},
        "outcome": {"type":"string", "minLength":1}
      }
    },
    "Ending": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nodeId", "consequence"],
      "properties": {
        "id": {"$ref":"#/definitions/Id"},
        "nodeId": {"$ref":"#/definitions/Id"},
        "consequence": {"type":"string", "minLength":1}
      }
    },
    "AtlasSettings": {"type":"object","additionalProperties":false,"required":["size","kmPerCell","land","ruggedness","climate","settlements","roads","politics"],"properties":{"size":{"enum":["small","standard"]},"kmPerCell":{"type":"number","minimum":0.1,"maximum":100},"land":{"type":"integer","minimum":35,"maximum":75},"ruggedness":{"type":"integer","minimum":0,"maximum":3},"climate":{"enum":["temperate","arid","cold"]},"settlements":{"type":"integer","minimum":0,"maximum":3},"roads":{"type":"integer","minimum":0,"maximum":3},"politics":{"type":"integer","minimum":0,"maximum":3},"landform":{"enum":["continent","islands"]}}},
    "AtlasConstraint": {"type":"object","additionalProperties":false,"required":["from","relation","strength","origin","description"],"properties":{"from":{"$ref":"#/definitions/Id"},"to":{"$ref":"#/definitions/Id"},"via":{"$ref":"#/definitions/Id"},"relation":{"enum":["near","beneath","separates","travel","river","inside","outside","canal","aqueduct"]},"strength":{"enum":["hard","soft"]},"origin":{"enum":["owner","scenario","proposal"]},"description":{"type":"string"}}},
    "AtlasPlacement": {"type":"object","additionalProperties":false,"required":["locationId"],"properties":{"locationId":{"$ref":"#/definitions/Id"},"label":{"type":"string","minLength":1},"kind":{"enum":["city","village","dungeon","landmark","port","town","capital","ruin","fortress","forest","underground","reservoir"]},"preference":{"enum":["any-land","plain","forest","mountain","desert"]},"regionId":{"$ref":"#/definitions/Id"},"position":{"$ref":"#/definitions/Point"},"description":{"type":"string"},"level":{"type":"integer","minimum":-32,"maximum":0},"area":{"type":"array","items":{"$ref":"#/definitions/Point"}},"locked":{"type":"boolean"},"factionIds":{"type":"array","items":{"$ref":"#/definitions/Id"}}}},
    "Territory": {"type":"object","additionalProperties":false,"required":["id","name","regionIds","factionIds"],"properties":{"id":{"$ref":"#/definitions/Id"},"name":{"type":"string","minLength":1},"regionIds":{"type":"array","items":{"$ref":"#/definitions/Id"}},"factionIds":{"type":"array","items":{"$ref":"#/definitions/Id"}}}},
    "World": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "seed", "generatorVersion", "tiles", "regions", "features", "locations", "routes"],
      "dependencies": {
        "settings": {
          "required":["name","sourceNarrativeId","sourceScenarioId","narrativeRevision","scenarioRevision","approved","elevation","constraints"],
          "properties":{
            "tiles":{"type":"array","minItems":1,"maxItems":128,"items":{"type":"string","minLength":1,"maxLength":128}},
            "elevation":{"type":"array","minItems":1,"maxItems":128,"items":{"type":"array","minItems":1,"maxItems":128}},
            "locations":{"type":"array","maxItems":128},"placements":{"type":"array","maxItems":128},"routes":{"type":"array","maxItems":512},"constraints":{"type":"array","maxItems":256}
          }
        }
      },
      "properties": {
        "id": {"$ref":"#/definitions/Id"},
        "seed": {"type":"integer", "minimum":0, "maximum":4294967295},
        "generatorVersion": {"type":"string", "minLength":1},
        "name": {"type":"string","minLength":1},
        "sourceNarrativeId": {"$ref":"#/definitions/Id"},
        "sourceScenarioId": {"$ref":"#/definitions/Id"},
        "narrativeRevision": {"type":"integer","minimum":0},
        "scenarioRevision": {"type":"integer","minimum":0},
        "approved": {"type":"boolean"},
        "settings": {"$ref":"#/definitions/AtlasSettings"},
        "constraints": {"type":"array","items":{"$ref":"#/definitions/AtlasConstraint"}},
        "placements": {"type":"array","items":{"$ref":"#/definitions/AtlasPlacement"}},
        "territories": {"type":"array","items":{"$ref":"#/definitions/Territory"}},
        "elevation": {"type":"array","items":{"type":"array","items":{"type":"integer","minimum":0}}},
        "tiles": {"type":"array", "items":{"type":"string", "pattern":"^[~pmfdhlvs]+$"}},
        "regions": {"type":"array", "items":{"$ref":"#/definitions/Region"}},
        "features": {"type":"array", "items":{"$ref":"#/definitions/TerrainFeature"}},
        "locations": {"type":"array", "items":{"$ref":"#/definitions/Location"}},
        "routes": {"type":"array", "items":{"$ref":"#/definitions/TravelRoute"}}
      }
    },
    "Region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "cells"],
      "properties": {
        "id": {"$ref":"#/definitions/Id"},
        "name": {"type":"string", "minLength":1},
        "cells": {"type":"array", "items":{"$ref":"#/definitions/Point"}, "minItems":1},
        "description": {"type":"string"},
        "climateException": {"type":"object","additionalProperties":false,"required":["biome","rule"],"properties":{"biome":{"type":"string","minLength":1},"rule":{"type":"string","minLength":1}}},
        "controllerId": {"$ref":"#/definitions/Id"}
      }
    },
    "TerrainFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "cells"],
      "properties": {
        "id": {"$ref":"#/definitions/Id"},
        "name": {"type":"string", "minLength":1},
        "kind": {"enum":["river", "ridge", "grove", "dunes", "lake", "basin"]},
        "cells": {"type":"array", "items":{"$ref":"#/definitions/Point"}, "minItems":1}
      }
    },
    "Location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "preference"],
      "properties": {
        "id": {"$ref":"#/definitions/Id"},
        "name": {"type":"string", "minLength":1},
        "kind": {"enum":["city","village","dungeon","landmark","port","town","capital","ruin","fortress","forest","underground","reservoir"]},
        "description": {"type":"string"},
        "level": {"type":"integer","minimum":-32,"maximum":0},
        "area": {"type":"array","items":{"$ref":"#/definitions/Point"}},
        "locked": {"type":"boolean"},
        "factionIds": {"type":"array","items":{"$ref":"#/definitions/Id"}},
        "generatedRole": {"enum":["settlement","harbor"]},
        "preference": {"enum":["any-land", "plain", "forest", "mountain", "desert"]},
        "position": {"$ref":"#/definitions/Point"},
        "regionId": {"$ref":"#/definitions/Id"}
      }
    },
    "TravelRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "mode", "path"],
      "properties": {
        "id": {"$ref":"#/definitions/Id"},
        "from": {"$ref":"#/definitions/Id"},
        "to": {"$ref":"#/definitions/Id"},
        "mode": {"enum":["road", "sea", "trail", "pass", "bridge", "tunnel", "canal", "aqueduct"]},
        "distanceKm": {"type":"number","minimum":0},
        "crossings": {"type":"array","items":{"$ref":"#/definitions/Point"}},
        "path": {"type":"array", "items":{"$ref":"#/definitions/Point"}, "minItems":2}
      }
    },
    "BlockedTransition": {
      "type":"object","additionalProperties":false,
      "required":["fieldPath","kind","key","actual","required","producerIds"],
      "properties":{
        "edgeId":{"$ref":"#/definitions/Id"}, "targetId":{"$ref":"#/definitions/Id"},
        "fieldPath":{"type":"string","minLength":1}, "kind":{"type":"string","minLength":1},
        "key":{"$ref":"#/definitions/Id"}, "actual":{"type":["string","null"]}, "required":{"type":"string"},
        "producerIds":{"type":"array","items":{"$ref":"#/definitions/Id"}}
      }
    },
    "ValidationFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id","rule","origin","severity","entityIds","explanation","suggestedRepair","status","checkedRevision","runId"],
      "properties": {
        "id": {"$ref":"#/definitions/Id"},
        "rule": {"type":"string", "minLength":1},
        "origin": {"enum":["deterministic", "editorial"]},
        "severity": {"enum":["error", "warning", "info"]},
        "entityIds": {"type":"array", "items":{"$ref":"#/definitions/Id"}, "uniqueItems":true},
        "explanation": {"type":"string", "minLength":1},
        "suggestedRepair": {"type":"string", "minLength":1},
        "fieldPath": {"type":"string","maxLength":256},
        "causeNodeId":{"$ref":"#/definitions/Id"},
        "spatialCell":{"$ref":"#/definitions/Point"},
        "blockedTransitions":{"type":"array","items":{"$ref":"#/definitions/BlockedTransition"}},
        "referenceId": {"$ref":"#/definitions/Id"},
        "expectedType": {"type":"string","maxLength":64},
        "actualType": {"type":"string","maxLength":64},
        "witnessPath": {"type":"array","items":{"$ref":"#/definitions/Id"}},
        "status": {"enum":["open", "proposed", "declined", "resolved", "superseded"]},
        "checkedRevision": {"type":"integer", "minimum":0},
        "runId": {"$ref":"#/definitions/Id"}
      }
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "outcome", "detail"],
      "properties": {
        "tool": {"type":"string", "minLength":1},
        "outcome": {"enum":["passed", "failed", "advice", "cancelled"]},
        "detail": {"type":"string", "minLength":1}
      }
    },
    "AgentRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stage", "baseRevision", "mode", "status", "repairAttempts", "receipts", "calls"],
      "properties": {
        "id": {"$ref":"#/definitions/Id"},
        "stage": {"enum":["candidates", "scenario", "world", "verify"]},
        "baseRevision": {"type":"integer", "minimum":0},
        "mode": {"enum":["deterministic", "mock", "live"]},
        "status": {"enum":["running", "proposed", "verified", "unresolved", "failed", "cancelled", "stale"]},
        "repairAttempts": {"type":"integer", "minimum":0, "maximum":2},
        "receipts": {"type":"array", "items":{"$ref":"#/definitions/Receipt"}},
        "calls": {"type":"integer", "minimum":0},
        "tokens": {"type":"integer", "minimum":0},
        "durationMs": {"type":"integer", "minimum":0}
      }
    },
    "Basis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["content"],
          "properties": {"content":{"type":"integer", "minimum":0}}
        },
        "narrative": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidates", "content"],
          "properties": {"candidates":{"type":"integer", "minimum":0}, "content":{"type":"integer", "minimum":0}}
        },
        "scenario": {
          "type": "object",
          "additionalProperties": false,
          "required": ["narrative", "content"],
          "properties": {"narrative":{"type":"integer", "minimum":0}, "content":{"type":"integer", "minimum":0}}
        },
        "world": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scenario", "narrative", "content"],
          "properties": {
            "scenario": {"type":"integer", "minimum":0},
            "narrative": {"type":"integer", "minimum":0},
            "content": {"type":"integer", "minimum":0}
          }
        }
      }
    },
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id","schemaVersion","title","revision","versions","basis","userContent","canonicalFacts","storyCandidates","characters","factions","nodes","edges","quests","endings","findings","runs"],
      "properties": {
        "scenario": {"$ref":"#/definitions/Scenario"},
        "id": {"$ref":"#/definitions/Id"},
        "schemaVersion": {"enum":["1.0.0"]},
        "title": {"type":"string", "minLength":1},
        "revision": {"type":"integer", "minimum":0},
        "versions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["content", "candidates", "narrative", "scenario", "world"],
          "properties": {
            "content": {"type":"integer", "minimum":0},
            "candidates": {"type":"integer", "minimum":0},
            "narrative": {"type":"integer", "minimum":0},
            "scenario": {"type":"integer", "minimum":0},
            "world": {"type":"integer", "minimum":0}
          }
        },
        "basis": {"$ref":"#/definitions/Basis"},
        "synthetic": {"type":"boolean"},
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runId", "revision"],
          "properties": {
            "runId": {"$ref":"#/definitions/Id"},
            "revision": {"type":"integer", "minimum":0}
          }
        },
        "userContent": {"type":"array", "items":{"$ref":"#/definitions/UserContent"}},
        "canonicalFacts": {"type":"array", "items":{"$ref":"#/definitions/CanonicalFact"}},
        "storyCandidates": {
          "oneOf": [{"type":"array","items":{"$ref":"#/definitions/StoryCandidate"},"maxItems":0},{"type":"array","items":{"$ref":"#/definitions/StoryCandidate"},"minItems":3,"maxItems":3}]
        },
        "narrative": {"$ref":"#/definitions/Narrative"},
        "characters": {"type":"array", "items":{"$ref":"#/definitions/Character"}},
        "factions": {"type":"array", "items":{"$ref":"#/definitions/Faction"}},
        "stateEntities": {"type":"array", "items":{"$ref":"#/definitions/StateEntity"}},
        "nodes": {"type":"array", "items":{"$ref":"#/definitions/ScenarioNode"}},
        "edges": {"type":"array", "items":{"$ref":"#/definitions/ScenarioEdge"}},
        "quests": {"type":"array", "items":{"$ref":"#/definitions/Quest"}},
        "endings": {"type":"array", "items":{"$ref":"#/definitions/Ending"}},
        "world": {"$ref":"#/definitions/World"},
        "findings": {"type":"array", "items":{"$ref":"#/definitions/ValidationFinding"}},
        "runs": {"type":"array", "items":{"$ref":"#/definitions/AgentRun"}}
      }
    }
  }
}
