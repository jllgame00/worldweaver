# Use the repository-root .env or the backend process environment. Process values win.
# Keep keys out of the frontend and Git.
WORLDWEAVER_PROVIDER=mock
# Leave blank for the provider default (gpt-6.2-sol for openai).
WORLDWEAVER_MODEL=
OPENAI_API_KEY=

# ChatKHU uses its own key and an ID confirmed with: python -m scripts.chatkhu models
CHATKHU_API_KEY=
CHATKHU_MODEL=
# responses or chat_completions, chosen explicitly for the model.
CHATKHU_API=responses

# Defaults are 8 seconds for mock and 90 for live providers.
WORLDWEAVER_TIMEOUT_SECONDS=
WORLDWEAVER_MAX_INPUT_BYTES=32768
WORLDWEAVER_MAX_OUTPUT_TOKENS=6000
# Keep at 1 during an approved live verification campaign.
WORLDWEAVER_LIVE_MAX_ATTEMPTS=1

# The direct OpenAI verify_live.py campaign needs explicit owner approval.
WORLDWEAVER_LIVE_VERIFY_MAX_CALLS=0
WORLDWEAVER_LIVE_VERIFY_BUDGET_USD=0
